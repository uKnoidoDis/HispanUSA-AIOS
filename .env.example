# ──────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Twilio (SMS)
# NOTE: code uses TWILIO_PHONE_NUMBER, not a Messaging Service SID
# ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ──────────────────────────────────────────────
# Resend (email)
# ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ──────────────────────────────────────────────
# App / misc
# ──────────────────────────────────────────────
CRON_SECRET=
NEXT_PUBLIC_APP_URL=

# ──────────────────────────────────────────────
# Module 2 Feature Flags (default false in production)
# ──────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_MODULE2_CLIENTS=false
NEXT_PUBLIC_FEATURE_MODULE2_TASKS=false
NEXT_PUBLIC_FEATURE_MODULE2_INVOICING=false
NEXT_PUBLIC_FEATURE_MODULE2_DOCUMENTS=false
NEXT_PUBLIC_FEATURE_MODULE2_BANK_STATEMENTS=false
NEXT_PUBLIC_FEATURE_MODULE2_IRS_TRIAGE=false
